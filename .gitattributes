# Batch files need CRLF line endings to run reliably on Windows,
# regardless of the committer's or cloner's line-ending settings.
*.bat text eol=crlf

# Everything else: normalize to LF in the repo, let git convert on
# checkout per the user's own core.autocrlf setting.
*.py text eol=lf
*.txt text eol=lf
*.md text eol=lf

# Binary files -- do not let git touch these at all.
*.ico binary
*.dict binary
*.ttf binary
*.png binary
